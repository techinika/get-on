# Get-On env
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TEAM_EMAIL=team@get-on.tech
BILLING_EMAIL=billing@contact.get-on.tech
SUPPORT_EMAIL=team@get-on.tech
PRIVACY_EMAIL=team@get-on.tech
ABUSE_EMAIL=team@get-on.tech

# Staff console. Identity is platform_staff + TOTP (AAL2); no email allow-list.
ADMIN_HOST=admin.get-on.tech
ADMIN_IP_ALLOWLIST=
ADMIN_BOOTSTRAP=false
EMAIL_TRACKING_BASE=https://get-on.tech
MARKETING_TOKEN_SECRET=

# Email delivery (Amazon SES, SMTP, or console).
# EMAIL_PROVIDER=ses  - use Amazon SES (requires AWS creds below)
# EMAIL_PROVIDER=smtp - use SMTP (requires SMTP config below)
# EMAIL_PROVIDER=log  - log to console (default for dev)
# EMAIL_PROVIDER=memory - in-memory (tests)
# EMAIL_PROVIDER=fake  - fake provider (tests)
EMAIL_PROVIDER=log
# SMTP configuration (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=no-reply@example.com
SMTP_NAME=Get-On
# Amazon SES configuration (set only when EMAIL_PROVIDER=ses)
SES_CONFIGURATION_SET_TRANSACTIONAL=gs-transactional
SES_CONFIGURATION_SET_BILLING=gs-billing
SES_CONFIGURATION_SET_MARKETING=gs-marketing
SES_DAILY_LIMIT=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_SNS_TOPIC_ARN=
EMAIL_LOGO_URL=
EMAIL_LOGO_2X_URL=
BACKUP_BUCKET=
EXPORT_BUCKET=
IMPORT_MAX_BYTES=314572800
STATS_SALT_SECRET=
CLOUDFLARE_ANALYTICS_API_TOKEN=
STATS_DATASET=site_hits
SITES_STATS_BINDING=STATS
TRANSFER_TOKEN_PEPPER=
DOMAINS_PROVIDER=fake
CF_API_TOKEN_DOMAINS=
CF_SAAS_ZONE_ID=
CF_SAAS_CNAME_TARGET=
CF_SAAS_HOSTNAMES_INCLUDED=100
CF_SAAS_MAX_HOSTNAMES=50000
DOMAINS_MAX_PENDING_HOSTNAMES=200
DOMAINS_PROVIDER_RPS=3
# Development-only admin actions (simulate a plan lapse). Leave unset in production.
# DOMAINS_ALLOW_SIMULATION=true
DOH_ENDPOINTS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json

# AI (Workers AI through AI Gateway). Use AI_PROVIDER=fake in development.
AI_PROVIDER=fake
AI_ENABLED=true
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
AI_GATEWAY_ID=
AI_CREDIT_NEURONS=100
AI_DAILY_CAP_CREDITS=5000
AI_IMAGES_ENABLED=false
AI_USD_PER_NEURON=0.000011

# Billing. Use PAYMENT_PROVIDER=fake in development. Production must use pesapal.
PAYMENT_PROVIDER=fake
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=

# Security hardening (email OTP two-step sign-in).
# OTP_PEPPER must be at least 32 random characters in production. Keep the
# previous value for one rotation so codes in flight still verify.
OTP_PEPPER=
OTP_PEPPER_PREVIOUS=
OTP_PEPPER_VERSION=1
# Signs short-lived pending-auth cookies (challenge, device). 32+ characters.
SECURITY_TOKEN_SECRET=
# Public origin used by origin checks and email links, e.g. https://get-on.tech
APP_ORIGIN=
# Jobs scheduler shared secret (HMAC of the tick request). 32+ characters.
JOBS_SECRET=
# Field encryption key ring: {"1":"<base64 32 bytes>"} and the current key id.
FIELD_KEYS=
FIELD_KEY_CURRENT=1
HIBP_ENABLED=true
IP_HASH_PEPPER_ROTATION=monthly
HEARTBEAT_URL=
CSP_ENFORCE=false
