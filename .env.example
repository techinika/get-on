# Public URL for metadata, callbacks and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon key (from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only. Used to write demo requests, because the
# demo_requests table has no row level security policies for normal users.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enable Google login button when true
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Support channels shown in the dashboard help panel
SUPPORT_EMAIL=support@get-on.tech
SUPPORT_WHATSAPP_NUMBER=15551234567

# Demo request form
# Salt used to hash IP addresses. The raw address is never stored.
IP_HASH_SALT=
# Secret used to sign the form time token. Defaults to SUPABASE_SERVICE_ROLE_KEY.
FORM_TOKEN_SECRET=
# Email delivery. Without a key the emails are written to the server log.
RESEND_API_KEY=
EMAIL_FROM=Get-On <hello@get-on.tech>
# Optional Cloudflare Turnstile. Both values are needed to switch it on.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Publishing storage. Without the Cloudflare values below, websites are built
# into .local-sites and served by `pnpm dev:sites` on http://localhost:8787.
# PUBLISH_STORE=local|cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_R2_BUCKET=
# ROOT_DOMAIN=get-on.tech
# LOCAL_SITES_DIR=.local-sites

# Legal pages
COMPANY_NAME=Get-On
LEGAL_ENTITY=
COMPANY_COUNTRY=
COMPANY_ADDRESS=
PRIVACY_EMAIL=privacy@get-on.tech
ABUSE_EMAIL=abuse@get-on.tech
LEGAL_EFFECTIVE_DATE=
# Set to false only after a lawyer has reviewed the legal pages.
LEGAL_REVIEW_PENDING=true
# Keep false until analytics or another non-essential cookie is added.
NEXT_PUBLIC_COOKIE_CONSENT=false

# Optional for Playwright local runs
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_ENABLE_SIGNUP=
