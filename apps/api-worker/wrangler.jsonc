{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "get-on-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.get-on.tech/*",
      "zone_name": "get-on.tech"
    }
  ],
  "vars": {
    "ROOT_DOMAIN": "get-on.tech",
    "APP_ORIGIN": "https://get-on.tech",
    "API_ORIGIN": "https://api.get-on.tech"
  },
  // Secrets set with `wrangler secret put`:
  //   CRON_SECRET, JOBS_SECRET, WORKER_SHARED_SECRET
  // Optional analytics secrets:
  //   CLOUDFLARE_ANALYTICS_API_TOKEN (or CLOUDFLARE_API_TOKEN), CLOUDFLARE_ZONE_ID
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "0 1 * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "get-on-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "get-on-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SITES_KV",
      "id": "93c90072f8fc4568a6abe94c78cc54fb",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
