{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "get-on-sites",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-22",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "*.get-on.tech/*",
			"zone_name": "get-on.tech"
		}
	],
	"vars": {
		"ROOT_DOMAIN": "get-on.tech",
		"APP_ORIGIN": "https://get-on.tech"
	},
	// Secrets set with `wrangler secret put`:
	//   FORM_TOKEN_SECRET, FORM_TOKEN_SECRET_PREVIOUS, WORKER_SHARED_SECRET
	"kv_namespaces": [
		{
			"binding": "SITES_KV",
			"id": "93c90072f8fc4568a6abe94c78cc54fb",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "SITES_BUCKET",
			"bucket_name": "get-on-sites-sites-bucket"
		},
		{
			"bucket_name": "get-on-sites",
			"binding": "get_on_sites",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}