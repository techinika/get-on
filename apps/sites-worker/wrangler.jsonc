{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "get-on-sites",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.get-on.tech/*",
      "zone_name": "get-on.tech"
    }
  ],
  "vars": {
    "ROOT_DOMAIN": "get-on.tech"
  },
  "kv_namespaces": [
    {
      "binding": "SITES_KV"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITES_BUCKET"
    }
  ],
  "observability": {
    "enabled": true
  }
}
