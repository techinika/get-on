{
  "name": "get-on",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @get-on/renderer build:css && pnpm --filter web dev",
    "dev:sites": "pnpm --filter web dev:sites",
    "dev:all": "pnpm --filter web dev:all",
    "seed:site": "pnpm --filter web seed:site",
    "build": "pnpm --filter @get-on/renderer build:css && pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @get-on/ai typecheck && pnpm --filter @get-on/billing typecheck && pnpm --filter @get-on/site-package typecheck",
    "test": "pnpm --filter web test && pnpm --filter @get-on/ai test && pnpm --filter @get-on/billing test && pnpm --filter @get-on/site-server test && pnpm --filter @get-on/site-package test && pnpm --filter @get-on/publisher test && pnpm --filter @get-on/sites-worker test",
    "test:e2e": "pnpm --filter web test:e2e",
    "screenshots": "pnpm --filter web screenshots",
    "job:email": "pnpm --filter web job:email",
    "job:cleanup": "pnpm --filter web job:cleanup",
    "job:backups": "pnpm --filter web job:backups",
    "job:backup-gc": "pnpm --filter web job:backup-gc",
    "job:exports-cleanup": "pnpm --filter web job:exports-cleanup",
    "job:imports-cleanup": "pnpm --filter web job:imports-cleanup",
    "job:transfers-expire": "pnpm --filter web job:transfers-expire",
    "job:deleted-purge": "pnpm --filter web job:deleted-purge",
    "job:subdomain-release": "pnpm --filter web job:subdomain-release",
    "job:activity-trim": "pnpm --filter web job:activity-trim",
    "job:invitations-expire": "pnpm --filter web job:invitations-expire",
    "job:referrals-qualify": "pnpm --filter web job:referrals-qualify",
    "job:team-reconcile": "pnpm --filter web job:team-reconcile",
    "job:redirects-resync": "pnpm --filter web job:redirects-resync",
    "job:billing": "pnpm --filter web job:billing",
    "job:backfill-media-hashes": "pnpm --filter web job:backfill-media-hashes",
    "job:all": "pnpm --filter web job:all",
    "job:domains": "pnpm --filter web job:domains",
    "job:domains-poll": "pnpm --filter web job:domains-poll",
    "job:domains-health": "pnpm --filter web job:domains-health",
    "job:domains-verify": "pnpm --filter web job:domains-verify",
    "job:domains-plan": "pnpm --filter web job:domains-plan",
    "job:domains-cleanup": "pnpm --filter web job:domains-cleanup",
    "job:migrate-pointers": "pnpm --filter web job:migrate-pointers",
    "job:ai": "pnpm --filter web job:ai",
    "job:ai-monthly": "pnpm --filter web job:ai-monthly",
    "job:ai-expire": "pnpm --filter web job:ai-expire",
    "job:ai-payloads": "pnpm --filter web job:ai-payloads",
    "job:rebuild-published": "pnpm --filter web job:rebuild-published"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.2"
  }
}
